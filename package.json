{
  "name": "tokenbar",
  "private": true,
  "displayName": "TokenBar",
  "description": "Bandeja do Windows que acompanha as cotas reais das assinaturas Claude, Codex e Antigravity.",
  "version": "0.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/n3tf4c3/tokenbar.git"
  },
  "bugs": {
    "url": "https://github.com/n3tf4c3/tokenbar/issues"
  },
  "homepage": "https://github.com/n3tf4c3/tokenbar#readme",
  "scripts": {
    "compile": "npm run compile-daemon",
    "compile-daemon": "esbuild src/daemon.ts --bundle --outfile=dist/daemon.js --format=cjs --platform=node",
    "watch": "esbuild src/daemon.ts --bundle --outfile=dist/daemon.js --format=cjs --platform=node --watch",
    "compile-tests": "esbuild src/test/test.ts --bundle --platform=node --outfile=dist/test.js",
    "test": "npm run compile-tests && node dist/test.js",
    "test:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File src/test/tray.test.ps1"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
